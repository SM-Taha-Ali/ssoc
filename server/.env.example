# SSOC - Smart Sales Operations Center Server Environment Configuration

# Application Port & Database
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ssoc

# 1. Google Gemini AI (Required for real AI audit, video script generation, pitch writing, & quick paste parsing)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 2. Outreach Delivery Provider (Options: 'manual', 'smtp', or 'resend')
EMAIL_PROVIDER=manual

# Option A: Direct SMTP (Gmail, Outlook, Zoho, Amazon SES, or custom mail server)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Option B: Resend API (High deliverability transactional email)
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=

# 3. Apollo.io Prospecting API (Optional: for cold lead generation of founders, CTOs & decision makers)
# Get your key at: https://app.apollo.io/#/settings/api
APOLLO_API_KEY=
